# ---- LLM backend ----
# LLM_BACKEND: "mock" runs a deterministic rule-based stand-in (no model needed,
# use this until ollama is available on the server). "ollama" calls a real model.
LLM_BACKEND=mock

# Only used when LLM_BACKEND=ollama. On the server, point this at the ollama daemon.
OLLAMA_BASE_URL=http://localhost:11434
# Fine-tuned model tags (after you fine-tune & `ollama create` them).
# Before fine-tuning you can point both at a base model, e.g. "qwen2.5:7b".
EXTRACTOR_MODEL=uspark-profile-extractor
PAIR_JUDGE_MODEL=uspark-pair-judge

# ---- Pipeline knobs ----
# Max candidate pairs per user handed to the (expensive) Pair Judge after cheap recall.
RECALL_TOP_K=50
# A pair judged below this fused final score is not emitted.
# The hybrid scale is more compressed than the old pure-rule one; 60 ≈ old 75.
SCORE_THRESHOLD=60
# Pair Judge is skipped when a cheap prefilter score is below this (cost control).
JUDGE_MIN_PREFILTER=40

# Global matching objective: "stable" = Gale-Shapley (no blocking pairs, Hinge-style),
# "greedy" = old max-weight greedy (kept for A/B comparison).
MATCHING_OBJECTIVE=stable
# Users who have waited >= this many match rounds get matching priority (anti-Matthew).
FAIRNESS_WAIT_ROUNDS=2

# ---- Security ----
# Shared secret required as `Authorization: Bearer <key>` on POST /match (P0-5).
# MUST equal the backend's AI_PROVIDER_API_KEY.
# Empty = auth disabled，且仅允许 HOST 为回环地址；非回环 + 空 key 会拒绝启动（fail-closed）。
MATCH_API_KEY=

# ---- Service ----
# 生产绑 0.0.0.0 前必须先设置 MATCH_API_KEY（否则拒绝启动）。
HOST=127.0.0.1
PORT=8100
LOG_LEVEL=info
