# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
POSTGRES_USER=campuslove
POSTGRES_PASSWORD=campuslove_secret
POSTGRES_DB=campuslove
DATABASE_URL=postgresql://campuslove:campuslove_secret@localhost:5432/campuslove

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
JWT_SECRET=change_this_jwt_secret_in_production_min_32_chars
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=change_this_admin_jwt_secret_in_production
ADMIN_JWT_EXPIRES_IN=8h

# ──────────────────────────────────────────────
# Seed Admin Account
# ──────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@campuslove.com
SEED_ADMIN_PASSWORD=Admin@123456

# ──────────────────────────────────────────────
# API Server
# ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ──────────────────────────────────────────────
# Admin Web
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_SECRET=change_this_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ──────────────────────────────────────────────
# AI Matching Provider (matching-ml 服务，BACKLOG P0-1)
# ──────────────────────────────────────────────
# MATCH_MODEL: ai | scoring。缺省：配置了 AI_PROVIDER_URL 即 ai，否则 scoring（本地打分回退）。
# 回滚到本地打分只需 MATCH_MODEL=scoring。
# MATCH_MODEL=ai
# 必须带 /match 路径
AI_PROVIDER_URL=http://localhost:8100/match
# 与 matching-ml 侧 MATCH_API_KEY 一致。生产必设（matching-ml 非回环绑定 + 空 key 会拒绝启动）；
# 本地两侧都留空可跑通，但会各自打警告。不要用占位串充数——占位串会掩盖「对端没配 key」的错误。
# AI_PROVIDER_API_KEY=<与 matching-ml MATCH_API_KEY 相同的强随机串>
# 请求超时（毫秒），缺省 300000
# AI_PROVIDER_TIMEOUT_MS=300000
